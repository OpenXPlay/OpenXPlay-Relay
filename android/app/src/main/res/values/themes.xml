<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DiRelay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#54E8A0</item>
        <!-- A resource reference: Android 9 and older ignore a literal colour here. -->
        <item name="android:windowBackground">@color/direlay_window_background</item>
        <item name="android:statusBarColor">#080808</item>
        <item name="android:navigationBarColor">#080808</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Without these, API 31+ shows a white splash before the dark Home screen. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#080808</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
