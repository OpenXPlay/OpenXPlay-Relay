set -e
# On upgrade the old relay keeps running until postinst restarts it with the new files.
if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
    deb-systemd-invoke stop openxplay-relay.service >/dev/null || :
fi
exit 0
